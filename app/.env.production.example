APP_NAME="Ujian Praktik Pemrograman Desktop"
APP_ENV=production
APP_KEY=                      # isi dengan: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://ujian-uts.khalidperwira.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---- Database (host = nama service di compose) ----
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ujian_api
DB_USERNAME=ujian
DB_PASSWORD=ganti-password-kuat-ini
DB_ROOT_PASSWORD=ganti-root-password-ini

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis      # ganti ke `sync` kalau tidak pakai worker

# ---- Di belakang reverse proxy ----
# Wajib, supaya url() dan request->ip() benar
TRUSTED_PROXIES=*
ASSET_URL=https://ujian-uts.khalidperwira.com

# ---- Khusus mode ujian ----
# Naikkan limit throttle saat ujian (36 siswa memukul API bersamaan)
API_RATE_LIMIT=600
# Rute auth (register/login) di-throttle per IP, bukan per user -> satu kelas
# yang keluar lewat satu IP sekolah (NAT) butuh limit lebih tinggi dari default (60)
AUTH_RATE_LIMIT=600
